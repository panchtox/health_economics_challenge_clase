# ===========================
# Carpeta de Evaluación (solo para el docente)
# ===========================
evaluacion/

# ===========================
# Archivos de configuración alternativos
# ===========================
codigo_base/CONFIG_minimo.yml
codigo_base/CONFIG_minimo_dsreducido.yml

# ===========================
# Archivos de Claude Code
# ===========================
.claude/

# ===========================
# OUTPUTS - Archivos generados (NO las carpetas)
# ===========================
# Ignoramos archivos pesados pero NO los .gitkeep
outputs/**/*.rds
outputs/**/*.rda
outputs/**/*.csv
outputs/**/*.RData
outputs/**/*.png
outputs/**/*.pdf

# NO ignorar los .gitkeep (los necesitamos para que persistan las carpetas)
!outputs/**/.gitkeep

# ===========================
# Archivos automáticos de R
# ===========================

# Historial de sesión
.Rhistory

# Datos de sesión
.RData

# Directorio de usuario de R
.Rproj.user/

# Archivos de proyecto de RStudio (opcional: dejamos el .Rproj principal)
# *.Rproj

# Archivos temporales de R
*~
.Rapp.history

# Archivos de salida de knitr
*-concordance.tex
*.synctex.gz

# OAuth2 tokens
.httr-oauth

# Archivos de ambiente de R
.Renviron

# Archivos de traducción
*.mo
*.pot

# Archivos de datos temporales de RStudio
*.Rproj.user

# Archivos de caché
*_cache/
/cache

# Archivos de salida de pkgdown
docs/
